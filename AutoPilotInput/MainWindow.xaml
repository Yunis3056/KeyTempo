<Window x:Class="AutoPilotInput.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KeyTempo" Width="1240" Height="850" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" PreviewKeyDown="WindowKeyDown">
 <Border CornerRadius="20" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource Backdrop}" ClipToBounds="True">
 <Grid x:Name="RootGrid">
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" MouseLeftButtonDown="DragWindow" Margin="24,0,16,0">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="10" Width="34" Height="34" Background="{DynamicResource Accent}"><TextBlock Text="↗" FontSize="26" Foreground="#201A31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="KeyTempo" FontSize="20" FontWeight="SemiBold" Margin="12,0,7,0" VerticalAlignment="Center"/><TextBlock Text="键奏" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Border Margin="16,0,0,0" Padding="7,3" CornerRadius="5" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"><TextBlock Text="v1.0" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/></Border></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SettingsButton" Content="⚙  设置" Tag="⚙  设置|⚙  Settings" Style="{StaticResource Small}" Click="SettingsClick" Margin="0,0,16,0"/><Button Content="—" Style="{StaticResource Small}" Click="MinimizeClick" Margin="0,0,5,0"/><Button Content="□" Style="{StaticResource Small}" Click="MaximizeClick" Margin="0,0,5,0"/><Button Content="×" Style="{StaticResource Small}" Click="CloseClick"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="24,10,24,10"><Grid.ColumnDefinitions><ColumnDefinition Width="282"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="把重复，交给节奏。" Tag="把重复，交给节奏。|Set your rhythm." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="专注眼前 · 让动作自动发生" Tag="专注眼前 · 让动作自动发生|Stay focused. Automate the repetition." Foreground="{DynamicResource Muted}" Margin="0,7,0,22" FontSize="12"/><DockPanel><TextBlock Text="动作队列" Tag="动作队列|ACTION QUEUE" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="ActionTotal" Text="01" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource Muted}"/></DockPanel></StackPanel>
    <ListBox x:Name="ActionList" Grid.Row="1" SelectionChanged="ActionSelectionChanged"/>
    <StackPanel Grid.Row="2"><Button Content="＋  键盘动作" Tag="＋  键盘动作|＋  Keyboard action" Click="AddKeyboardClick" Margin="0,10,0,8"/><Button Content="＋  鼠标动作" Tag="＋  鼠标动作|＋  Mouse action" Click="AddMouseClick" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Padding="15"><StackPanel><TextBlock Text="你的下一步" Tag="你的下一步|YOUR NEXT STEP" Foreground="{DynamicResource Accent}" FontSize="11"/><TextBlock Text="选择或录制按键，然后绑定目标窗口。切到目标窗口，按 F8 开始。" Tag="选择或录制按键，然后绑定目标窗口。切到目标窗口，按 F8 开始。|Choose a key, bind a target, then switch to it and press F8." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="21" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="102"/></Grid.RowDefinitions>
    <Border Grid.Row="0" CornerRadius="17" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#35294F" Offset="0"/><GradientStop Color="#182934" Offset="1"/></LinearGradientBrush></Border.Background><Grid>
     <Ellipse x:Name="Glow" Width="210" Height="210" HorizontalAlignment="Right" Margin="0,-95,-45,0" Opacity="0.35"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#A78BFA" Offset="0"/><GradientStop Color="#00A78BFA" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
     <Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Fill="#A7A5BC" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="已就绪" Foreground="#E7DEFC" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="CountdownText" Text="05:00" FontFamily="Consolas" FontSize="40" FontWeight="Bold" Foreground="White"/><TextBlock Text="距离下一次动作" Tag="距离下一次动作|UNTIL NEXT ACTION" Foreground="#B7B6CF" FontSize="11" VerticalAlignment="Bottom" Margin="15,0,0,9"/></StackPanel><TextBlock x:Name="NextText" Text="配置完成后，即可启程" Foreground="#B7B6CF" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="StartButton" Content="▶  开始全部" Style="{StaticResource Primary}" Click="StartClick" MinWidth="143" Margin="0,0,0,9"/><Button Content="■  停止全部" Tag="■  停止全部|■  Stop all" Click="StopClick" Background="#302C45" Foreground="#EBE7F7" BorderBrush="#5A4F6C"/></StackPanel></Grid>
    </Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><TextBlock Text="编辑动作" Tag="编辑动作|ACTION DETAILS" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="SaveStatus" Text="自动保存" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="删除" Tag="删除|Delete" Style="{StaticResource Small}" Click="DeleteClick"/></StackPanel></DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Editor" Margin="0,0,10,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="动作名称" Tag="动作名称|Name" Style="{StaticResource Label}"/><TextBox x:Name="NameBox" TextChanged="FormTextChanged"/></StackPanel><CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="启用" Tag="启用|Enabled" IsChecked="True" Margin="20,20,0,0" Checked="FormChanged" Unchecked="FormChanged"/></Grid>
      <StackPanel x:Name="KeyboardPanel" Margin="0,16,0,0"><TextBlock Text="按键 / 组合键" Tag="按键 / 组合键|Key / shortcut" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="KeyCombo" SelectionChanged="KeyComboChanged"/><Button Grid.Column="1" x:Name="RecordButton" Content="⌨  录制按键" Tag="⌨  录制按键|⌨  Record keys" Margin="10,0,0,0" Click="RecordKeyClick"/></Grid><TextBlock x:Name="KeyHint" Text="尚未选择按键" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
      <StackPanel x:Name="MousePanel" Visibility="Collapsed" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="MouseButtonCombo" SelectionChanged="FormSelectionChanged"/><ComboBox x:Name="ClickTypeCombo" Grid.Column="2" SelectionChanged="FormSelectionChanged"/><ComboBox x:Name="CoordinateCombo" Grid.Column="4" SelectionChanged="FormSelectionChanged"/></Grid><DockPanel Margin="0,12,0,7" LastChildFill="False"><Button x:Name="CaptureButton" Content="◎  录制位置" Tag="◎  录制位置|◎  Record positions" Click="CaptureClick" Style="{StaticResource Small}"/><Button Content="移除位置" Tag="移除位置|Remove point" Click="RemovePointClick" Style="{StaticResource Small}" Margin="8,0,0,0"/><Button Content="↑" Click="MovePointUpClick" Style="{StaticResource Small}" Margin="8,0,0,0"/><Button Content="↓" Click="MovePointDownClick" Style="{StaticResource Small}" Margin="5,0,0,0"/></DockPanel><ListBox x:Name="PointsList" Height="85" ItemContainerStyle="{StaticResource PointItem}"/><TextBlock x:Name="CaptureHint" Text="F6 记录当前位置，F7 完成；先绑定目标窗口" Tag="F6 记录当前位置，F7 完成；先绑定目标窗口|F6 captures · F7 finishes · bind the target first" Foreground="{DynamicResource Muted}" FontSize="11"/><DockPanel Margin="0,10,0,0"><TextBlock Text="位置之间停顿（毫秒）" Tag="位置之间停顿（毫秒）|Delay between points (ms)" Style="{StaticResource Label}" VerticalAlignment="Center"/><TextBox x:Name="PointDelayBox" Text="150" Width="90" HorizontalAlignment="Right" TextChanged="FormTextChanged"/></DockPanel></StackPanel>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="计时方式" Tag="计时方式|Timing mode" Style="{StaticResource Label}"/><ComboBox x:Name="IntervalModeCombo" SelectionChanged="IntervalModeChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="首次执行" Tag="首次执行|First execution" Style="{StaticResource Label}"/><ComboBox x:Name="FirstRunCombo" SelectionChanged="FormSelectionChanged"/></StackPanel></Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="IntervalLabel" Text="间隔（秒）" Style="{StaticResource Label}"/><TextBox x:Name="IntervalBox" Text="300" TextChanged="FormTextChanged"/></StackPanel><StackPanel x:Name="SecondIntervalPanel" Grid.Column="2" Visibility="Collapsed"><TextBlock x:Name="SecondIntervalLabel" Text="随机幅度（秒）" Style="{StaticResource Label}"/><TextBox x:Name="SecondIntervalBox" Text="30" TextChanged="FormTextChanged"/></StackPanel></Grid>
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Stroke}" Margin="0,17,0,0" Padding="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="目标窗口" Tag="目标窗口|Target window" Style="{StaticResource Label}"/><TextBlock x:Name="TargetText" Text="未绑定 · 点击右侧，然后切到目标窗口" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock x:Name="TargetHelp" Text="切换到其他窗口时暂停发送，不抢占焦点" Tag="切换到其他窗口时暂停发送，不抢占焦点|Pauses when the target loses focus" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button x:Name="BindButton" Grid.Column="1" Content="◎  绑定窗口" Tag="◎  绑定窗口|◎  Bind target" Click="BindTargetClick" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Border>
     </StackPanel></ScrollViewer>
    </Grid></Border>
    <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="15,10"><StackPanel><TextBlock Text="已完成动作" Tag="已完成动作|CYCLES COMPLETED" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="CountText" Text="0" FontFamily="Consolas" FontSize="26" Margin="0,4,0,0"/><TextBlock x:Name="LastText" Text="最近执行 —" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="15,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="活动记录" Tag="活动记录|ACTIVITY" Foreground="{DynamicResource Muted}" FontSize="10"/><ListBox x:Name="LogList" Grid.Row="1" Margin="0,5,0,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Grid></Border></Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,0"><DockPanel><TextBlock x:Name="FooterText" Text="●  离线就绪" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="HotkeyText" Text="F8  开始 / 暂停     F9  停止     ·     MIT 开源" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
  <Border x:Name="Toast" Grid.Row="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="11" Padding="20,13" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,0,20,0" Visibility="Collapsed"><TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="700"/></Border>
  <ResizeGrip Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16"/><Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#B0000000" Visibility="Collapsed"><Border Style="{StaticResource Card}" Width="610" MaxHeight="760" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><TextBlock Text="偏好设置" Tag="偏好设置|PREFERENCES" FontSize="20" FontWeight="SemiBold"/><Button Content="×" Style="{StaticResource Small}" Click="SettingsCloseClick" HorizontalAlignment="Right"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="主题" Tag="主题|Theme" Style="{StaticResource Label}"/><ComboBox x:Name="ThemeCombo" SelectionChanged="SettingsChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="语言" Tag="语言|Language" Style="{StaticResource Label}"/><ComboBox x:Name="LanguageCombo" SelectionChanged="SettingsChanged"/></StackPanel></Grid>
   <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="强调色（#RRGGBB）" Tag="强调色（#RRGGBB）|Accent color (#RRGGBB)" Style="{StaticResource Label}"/><TextBox x:Name="AccentBox" LostFocus="SettingsLostFocus"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="动效" Tag="动效|Motion" Style="{StaticResource Label}"/><ComboBox x:Name="MotionCombo" SelectionChanged="SettingsChanged"/></StackPanel></Grid>
   <TextBlock Text="窗口不透明度" Tag="窗口不透明度|Window opacity" Style="{StaticResource Label}" Margin="0,16,0,7"/><Slider x:Name="OpacitySlider" Minimum="0.75" Maximum="1" Value="1" ValueChanged="OpacityChanged"/>
   <WrapPanel Margin="0,16,0,5"><CheckBox x:Name="SoundCheck" Content="动作声音" Tag="动作声音|Action sound" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,0,20,10"/><CheckBox x:Name="NotificationsCheck" Content="桌面通知" Tag="桌面通知|Desktop notifications" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,0,20,10"/></WrapPanel>
   <TextBlock Text="全局快捷键" Tag="全局快捷键|GLOBAL SHORTCUTS" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,10,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始 / 暂停" Tag="开始 / 暂停|Start / pause" Style="{StaticResource Label}"/><TextBox x:Name="StartHotkeyBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="停止" Tag="停止|Stop" Style="{StaticResource Label}"/><TextBox x:Name="StopHotkeyBox"/></StackPanel></Grid><Button Content="应用快捷键" Tag="应用快捷键|Apply shortcuts" Click="ApplyHotkeysClick" Margin="0,10,0,0"/><TextBlock Text="例如 F8 或 Ctrl+Alt+F8；F6/F7 用于录制位置" Tag="例如 F8 或 Ctrl+Alt+F8；F6/F7 用于录制位置|Example: F8 or Ctrl+Alt+F8. F6/F7 are for capture." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,15"/>
   <TextBlock Text="异常处理" Tag="异常处理|ERROR HANDLING" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="窗口 / 权限异常" Tag="窗口 / 权限异常|Window / permission error" Style="{StaticResource Label}"/><ComboBox x:Name="TargetPolicyCombo" SelectionChanged="SettingsChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="坐标越界" Tag="坐标越界|Point outside screen" Style="{StaticResource Label}"/><ComboBox x:Name="PointPolicyCombo" SelectionChanged="SettingsChanged"/></StackPanel></Grid>
   <TextBlock Text="Windows 拒绝输入" Tag="Windows 拒绝输入|Input rejected by Windows" Style="{StaticResource Label}" Margin="0,12,0,7"/><ComboBox x:Name="InputPolicyCombo" SelectionChanged="SettingsChanged"/><TextBlock Text="配置与更新" Tag="配置与更新|CONFIGURATION &amp; UPDATES" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,20,0,12"/><StackPanel Orientation="Horizontal"><Button Content="导入配置" Tag="导入配置|Import" Click="ImportClick" Margin="0,0,10,0"/><Button Content="导出配置" Tag="导出配置|Export" Click="ExportClick"/></StackPanel><TextBlock Text="GitHub 仓库（owner/repo）" Tag="GitHub 仓库（owner/repo）|GitHub repository (owner/repo)" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox x:Name="RepositoryBox" LostFocus="SettingsLostFocus"/><Button Content="手动检查更新" Tag="手动检查更新|Check for updates" Click="UpdateClick" Margin="0,10,0,0"/><TextBlock Text="仅点击检查更新时联网。不收集任何使用数据。" Tag="仅点击检查更新时联网。不收集任何使用数据。|Connects only when you check. No usage data collected." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer></Grid></Border></Grid>
 </Grid></Border>
</Window>
