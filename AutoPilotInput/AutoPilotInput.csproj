<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KeyTempo</AssemblyName>
    <Product>KeyTempo</Product>
    <Title>KeyTempo</Title>
    <RootNamespace>AutoPilotInput</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Description>Offline keyboard and mouse automation for Windows</Description>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/app.ico" /></ItemGroup>
</Project>
